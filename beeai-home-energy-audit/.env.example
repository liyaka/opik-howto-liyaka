# OpenAI key: the audit agent runs on gpt-4o-mini
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Opik workspace that holds the "beeai-home-energy-audit" project (sent as the Comet-Workspace header)
# https://www.comet.com/docs/opik/
OPIK_WORKSPACE=default

# Optional: OTLP base URL of your Opik. Default is a local self-hosted Opik.
# Opik Cloud: https://www.comet.com/opik/api/v1/private/otel (also needs an Authorization header, see README)
# https://www.comet.com/docs/opik/tracing/opentelemetry/overview
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5173/api/v1/private/otel
