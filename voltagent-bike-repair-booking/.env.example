# OpenAI key for the gpt-4o-mini agent: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Opik Cloud API key (leave empty for a local self-hosted Opik): https://www.comet.com/docs/opik/ (Settings -> API Keys)
OPIK_API_KEY=
# Opik workspace name, shown top-left in the Opik UI (use "default" locally): https://www.comet.com/docs/opik/
OPIK_WORKSPACE=default

# Opik project that receives the traces (defaults to voltagent-bike-repair-booking): https://www.comet.com/docs/opik/tracing/log_traces
# OPIK_PROJECT_NAME=voltagent-bike-repair-booking
# Self-hosted Opik API base, e.g. http://localhost:5173/api (default is Opik Cloud): https://www.comet.com/docs/opik/self-host/overview
# OPIK_URL_OVERRIDE=http://localhost:5173/api
# Set to "off" to export VoltAgent's raw attributes without the gen_ai.* mapping: https://www.comet.com/docs/opik/integrations/voltagent
# OTEL_GENAI_MAPPING=off
