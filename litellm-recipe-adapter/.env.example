# OpenAI key for gpt-4o-mini
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Anthropic key for claude-haiku
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Opik server for local self-hosted; omit to use ~/.opik.config (see `opik configure`)
# https://www.comet.com/docs/opik/tracing/sdk_configuration
OPIK_URL_OVERRIDE=http://localhost:5173/api/
# Opik workspace name
# https://www.comet.com/docs/opik/tracing/sdk_configuration
OPIK_WORKSPACE=default
# Only for Opik Cloud, leave empty for local
# https://www.comet.com/docs/opik/tracing/sdk_configuration
OPIK_API_KEY=
