# OpenAI key for the gpt-4o-mini model behind the chat. Get one at:
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opik Cloud API key. Leave empty when you run Opik locally. Get one at:
# https://www.comet.com/docs/opik/ (Quickstart > API key)
OPIK_API_KEY=

# Opik workspace name ("default" for a local install). See:
# https://www.comet.com/docs/opik/
OPIK_WORKSPACE=default

# Opik API base URL. Local self-hosted shown; omit for Opik Cloud. See:
# https://www.comet.com/docs/opik/self-host/overview
OPIK_URL_OVERRIDE=http://localhost:5173/api/
