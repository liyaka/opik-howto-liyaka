# Provider key: https://platform.openai.com/api-keys (or put it in a repo-root .env, which the demo also reads).
OPENAI_API_KEY=

# Opik (local self-hosted shown; docs: https://www.comet.com/docs/opik/).
# URL of the Opik API; for Opik Cloud use https://www.comet.com/opik/api and set OPIK_API_KEY.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
# Opik workspace name.
OPIK_WORKSPACE=default
# Opik project that receives the traces.
OPIK_PROJECT_NAME=openai-ts-museum-visitor-desk
