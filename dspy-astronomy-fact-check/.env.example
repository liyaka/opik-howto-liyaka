# OpenAI API key: used by the DSPy program (gpt-4o-mini), by the BootstrapFewShot compile step
# and by the Opik test-suite judge.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Opik Cloud only: leave these out for a local Opik (`opik configure --use_local`).
# Where to find them: https://www.comet.com/docs/opik/
# OPIK_API_KEY=
# OPIK_WORKSPACE=
