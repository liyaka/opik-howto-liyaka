# OpenAI key used for title generation and for the test-suite judge
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opik server URL (local self-hosted shown; for Opik Cloud use https://www.comet.com/opik/api/ and set OPIK_API_KEY)
# https://www.comet.com/docs/opik/
OPIK_URL_OVERRIDE=http://localhost:5173/api/

# Opik workspace the traces, prompts and suite are written to
# https://www.comet.com/docs/opik/
OPIK_WORKSPACE=default

# Opik API key, only needed for Opik Cloud
# https://www.comet.com/docs/opik/tracing/sdk_configuration
# OPIK_API_KEY=
