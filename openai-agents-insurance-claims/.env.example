# OpenAI key used by every agent in the claims desk.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Opik defaults to a local self-hosted instance via ~/.opik.config (run `opik configure --use_local`).
# For Comet cloud instead, uncomment and fill in. https://www.comet.com/docs/opik/
# OPIK_API_KEY=
# OPIK_WORKSPACE=
# OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
