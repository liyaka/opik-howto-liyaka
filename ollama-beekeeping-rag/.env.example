# No model-provider key is needed: chat and embeddings both run in a local Ollama.
# Install Ollama: https://ollama.com/download  (then: ollama pull llama3.2:1b && ollama pull nomic-embed-text)

# Where your Ollama server listens. Default shown; change only if you moved it.
# https://github.com/ollama/ollama/blob/main/docs/faq.md
OLLAMA_URL=http://localhost:11434

# Opik Cloud only (skip if you ran `opik configure` or use a self-hosted Opik).
# https://www.comet.com/docs/opik/
# OPIK_API_KEY=
# OPIK_WORKSPACE=

# Self-hosted Opik: point the SDK at your instance so traces stay on your network too.
# https://www.comet.com/docs/opik/self-host/overview
# OPIK_URL_OVERRIDE=http://localhost:5173/api/
