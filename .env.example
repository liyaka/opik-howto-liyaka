# Copy to .env at the repo root. Every example reads this file (walking up from its own folder),
# so one set of credentials serves all of them. .env is git-ignored.

# --- Opik ---
# Local self-hosted Opik: https://www.comet.com/docs/opik/self-host/overview
OPIK_URL_OVERRIDE=http://localhost:5173/api/
# Workspace name ("default" on a local install). Some TypeScript examples read OPIK_WORKSPACE_NAME instead.
# https://www.comet.com/docs/opik/tracing/sdk_configuration
OPIK_WORKSPACE=default
OPIK_WORKSPACE_NAME=default
# Opik Cloud only; leave empty for a local Opik. https://www.comet.com/docs/opik/tracing/sdk_configuration
OPIK_API_KEY=
# OTLP endpoint for the OpenTelemetry-based examples (Pydantic AI, n8n and others).
# https://www.comet.com/docs/opik/tracing/opentelemetry/overview
OPIK_OTLP_ENDPOINT=http://localhost:5173/api/v1/private/otel
# Set to true to turn Opik tracking off (the offline tests do this for you).
# https://www.comet.com/docs/opik/tracing/sdk_configuration
# OPIK_TRACK_DISABLE=true
# Each example sets its own project name; only set OPIK_PROJECT_NAME inside a single example's shell.

# --- Model providers ---
# Used by almost every example. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Used by anthropic-ts-boardgame-rules-qa and litellm-recipe-adapter. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Local models ---
# ollama-beekeeping-rag talks to a local Ollama server. https://ollama.com/download
OLLAMA_URL=http://localhost:11434
