# OpenAI API key; setup.sh turns it into an n8n credential at run time,
# so it is never written into the committed workflow file.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Where the n8n container sends its OTLP spans. The default reaches a local self-hosted Opik on the host;
# for Opik Cloud use https://www.comet.com/opik/api/v1/private/otel
# https://www.comet.com/docs/opik/tracing/opentelemetry/overview
OPIK_OTLP_ENDPOINT=http://host.docker.internal:5173/api/v1/private/otel

# Opik workspace that receives the traces ("default" on a local install)
# https://www.comet.com/docs/opik/tracing/sdk_configuration
OPIK_WORKSPACE=default

# Opik Cloud API key; leave empty for a local Opik
# https://www.comet.com/docs/opik/tracing/sdk_configuration
OPIK_API_KEY=
