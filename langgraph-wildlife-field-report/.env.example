# OpenAI API key, used by the planner, researcher and writer (all gpt-4o-mini).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key

# Optional: Opik Cloud credentials. Skip both if you run Opik locally or have
# already run `opik configure`. Docs: https://www.comet.com/docs/opik/
# API key: https://www.comet.com/opik (Settings > API keys)
OPIK_API_KEY=
# Your Opik workspace name (shown in the Opik UI URL)
OPIK_WORKSPACE=
