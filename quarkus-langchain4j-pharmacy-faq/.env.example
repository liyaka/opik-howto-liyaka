# OpenAI key for gpt-4o-mini (chat) and text-embedding-3-small (embeddings).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Workspace the traces go to; "default" is right for a local Opik.
# https://www.comet.com/docs/opik/
OPIK_WORKSPACE=default

# Optional. OTLP base URL of your Opik; this is the local default. The Opik Cloud one is
# https://www.comet.com/opik/api/v1/private/otel (it also needs an Authorization header).
# https://www.comet.com/docs/opik/tracing/opentelemetry/overview
OPIK_OTEL_ENDPOINT=http://localhost:5173/api/v1/private/otel
