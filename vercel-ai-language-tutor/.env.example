# OpenAI API key: gpt-4o-mini plays the tutor (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Opik endpoint: local self-hosted Opik (https://www.comet.com/docs/opik/self-host/overview)
# For Opik Cloud use https://www.comet.com/opik/api
OPIK_URL_OVERRIDE=http://localhost:5173/api/

# Opik workspace: "default" on a local install (https://www.comet.com/docs/opik/)
OPIK_WORKSPACE=default

# Opik API key: only needed on Opik Cloud, leave unset locally (https://www.comet.com/opik)
# OPIK_API_KEY=your-opik-api-key

# Opik project that receives the traces and holds the rule (defaults to the folder name)
# OPIK_PROJECT_NAME=vercel-ai-language-tutor
