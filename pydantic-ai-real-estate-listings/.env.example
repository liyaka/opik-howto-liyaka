# Provider key for the extraction agent (gpt-4o-mini) and the suite's LLM judge
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Opik: local OTLP endpoint and workspace; override for a hosted workspace
# https://www.comet.com/docs/opik/tracing/opentelemetry/overview
OPIK_OTLP_ENDPOINT=http://localhost:5173/api/v1/private/otel
OPIK_WORKSPACE=default
# Only for Opik Cloud (leave empty for local)
OPIK_API_KEY=
