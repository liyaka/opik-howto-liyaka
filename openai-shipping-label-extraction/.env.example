# OpenAI API key, used by gpt-4o-mini to read the label images and to judge the suite
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key
# Opik API key, only needed for Opik Cloud or a secured server (skip it if you ran `opik configure` for a local install)
# https://www.comet.com/docs/opik/
OPIK_API_KEY=
# Opik workspace name, only needed if you did not run `opik configure`
# https://www.comet.com/docs/opik/
OPIK_WORKSPACE=
# Opik API base URL, only for a self-hosted server (e.g. http://localhost:5173/api/)
# https://www.comet.com/docs/opik/self-host/overview
OPIK_URL_OVERRIDE=
